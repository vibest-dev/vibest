{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": false,
  "semi": false,
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 120,
  "trailingComma": "all",
  "experimentalSortImports": {},
  "ignorePatterns": [
    "apps/vibest-herdr-app/home/mods/*/main.js",
    "**/dist/**",
    "**/node_modules/**",
    "packages/effect-herdr-sdk/src/generated/**",
    "packages/effect-herdr-sdk/schema/**",
    "packages/effect-herdr-core-sdk/src/generated/**",
    "packages/effect-herdr-core-sdk/schema/**",
    "packages/protocol/contract/**"
  ]
}
