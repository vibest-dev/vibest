{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/no-unused-vars": "error",
    // A ternary is sometimes the effect: delete the variable, or assign it.
    "eslint/no-unused-expressions": ["error", { "allowTernary": true }]
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".cache",
    "packages/effect-herdr-sdk/src/generated"
  ]
}
