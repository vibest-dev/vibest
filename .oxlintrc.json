{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "./tools/oxlint/node-import-style.mjs",
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    }
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "unicorn/prefer-node-protocol": "error",
    "vibest/node-import-style": "error",
    "vibest/no-restricted-disable": "error",
    "vibest/no-comments": "error",
    "vibest/event-reads": "error",
    "vibest/no-payload-sql": "error",
    "vibest/projector-writes": "error",
    "vibest/no-background-loop": "error",
    "vibest/no-module-let": "error",
    "vibest/package-imports": "error",
    "eslint/no-unused-vars": "error",
    "eslint/no-unused-expressions": [
      "error",
      {
        "allowTernary": true
      }
    ],
    "eslint/max-lines": [
      "error",
      {
        "max": 1000,
        "skipBlankLines": false,
        "skipComments": false
      }
    ],
    "anti-slop/no-chained-type-assertions": "off",
    "anti-slop/no-conditional-empty-object-spread": "off",
    "anti-slop/no-known-value-widening": "off",
    "anti-slop/no-module-mocking": "off",
    "anti-slop/no-object-parameters": "off",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "off",
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "off",
    "anti-slop/no-unknown-parameters": "off",
    "anti-slop/no-unknown-returns": "off",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "off",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "off",
    "anti-slop-effect/no-service-constructor-imports": "off"
  },
  "overrides": [
    {
      "files": [
        "packages/schema/src/**",
        "packages/plugin/src/**",
        "packages/protocol/src/**",
        "packages/client/src/**",
        "packages/core/src/**",
        "packages/server/src/**",
        "packages/plugin-harnesses/src/**",
        "packages/runtime-herdr/src/**",
        "packages/runtime-herdr-core/src/**",
        "packages/integration/*/src/**",
        "packages/effect-herdr-sdk/src/**",
        "packages/effect-herdr-core-sdk/src/**",
        "tools/verify/src/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(@effect/(platform|sql-sqlite)-bun(/|$)|bun:)",
                "message": "Bun-specific imports belong in platform folders and bun.ts files."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/schema/src/**/bun.ts",
        "packages/plugin/src/**/bun.ts",
        "packages/protocol/src/**/bun.ts",
        "packages/client/src/**/bun.ts",
        "packages/core/src/**/bun.ts",
        "packages/server/src/**/bun.ts",
        "packages/plugin-harnesses/src/**/bun.ts",
        "packages/runtime-herdr/src/**/bun.ts",
        "packages/runtime-herdr-core/src/**/bun.ts",
        "packages/integration/*/src/**/bun.ts",
        "packages/effect-herdr-sdk/src/**/bun.ts",
        "packages/effect-herdr-core-sdk/src/**/bun.ts",
        "tools/verify/src/**/bun.ts",
        "packages/schema/src/platform/**",
        "packages/plugin/src/platform/**",
        "packages/protocol/src/platform/**",
        "packages/client/src/platform/**",
        "packages/core/src/platform/**",
        "packages/server/src/platform/**",
        "packages/plugin-harnesses/src/platform/**",
        "packages/runtime-herdr/src/platform/**",
        "packages/runtime-herdr-core/src/platform/**",
        "packages/integration/*/src/platform/**",
        "packages/effect-herdr-sdk/src/platform/**",
        "packages/effect-herdr-core-sdk/src/platform/**",
        "tools/verify/src/platform/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".cache",
    "packages/effect-herdr-sdk/src/generated",
    "packages/effect-herdr-core-sdk/src/generated",
    "tools/oxlint/anti-slop"
  ]
}
