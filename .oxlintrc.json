{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./tools/oxlint/node-import-style.mjs"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "unicorn/prefer-node-protocol": "error",
    "vibest/node-import-style": "error",
    "vibest/no-restricted-disable": "error",
    "vibest/no-comments": "error",
    "eslint/no-unused-vars": "error",
    "eslint/no-unused-expressions": ["error", { "allowTernary": true }],
    "eslint/max-lines": ["error", { "max": 1000, "skipBlankLines": false, "skipComments": false }]
  },
  "overrides": [
    {
      "files": [
        "packages/plugin-harnesses/src/**",
        "packages/runtime-herdr/src/**",
        "packages/runtime-herdr-core/src/**",
        "packages/integration/*/src/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@vibest/*",
                  "@vibest/*/**",
                  "!@vibest/plugin",
                  "!@vibest/plugin/**",
                  "!@vibest/schema",
                  "!@vibest/schema/**",
                  "!@vibest/protocol",
                  "!@vibest/protocol/**",
                  "!@vibest/client",
                  "!@vibest/client/**"
                ],
                "message": "Builtin plugins and harness integrations import only @vibest/plugin, schema, protocol and client."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/builtins/src/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@vibest/core",
                  "@vibest/core/**",
                  "@vibest/server",
                  "@vibest/server/**",
                  "@vibest/cli",
                  "@vibest/cli/**"
                ],
                "message": "The builtin list imports plugin packages, never vibest internals."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".cache",
    "packages/effect-herdr-sdk/src/generated",
    "packages/effect-herdr-core-sdk/src/generated"
  ]
}
