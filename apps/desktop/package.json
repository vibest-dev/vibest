{
  "name": "desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Vibest Desktop Application",
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:unpack": "electron-builder --dir",
    "build:mac": "electron-builder --mac",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:headed": "playwright test -c e2e/playwright.config.ts --headed",
    "e2e:report": "playwright show-report e2e/report",
    "postinstall": "electron-builder install-app-deps",
    "clean": "git clean -xdf node_modules dist .turbo"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.97",
    "@electron-toolkit/utils": "^4.0.0",
    "@orpc/client": "2.0.0-beta.16",
    "@orpc/contract": "2.0.0-beta.16",
    "@orpc/experimental-effect": "2.0.0-beta.16",
    "@orpc/server": "2.0.0-beta.16",
    "@vibest/app": "workspace:*",
    "@vibest/cli": "workspace:*",
    "effect": "4.0.0-beta.97",
    "react-error-boundary": "^6.1.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@orpc/tanstack-query": "^2.0.0-beta.16",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/router-plugin": "^1.168.19",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vibest/ui": "workspace:*",
    "@vitejs/plugin-react": "^6.0.3",
    "clsx": "^2.1.1",
    "code-inspector-plugin": "latest",
    "dmg-builder": "26.4.0",
    "electron": "^41.10.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "lucide-react": "^1.24.0",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "p-queue": "^9.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-scan": "^0.5.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
