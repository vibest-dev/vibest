{
  "name": "desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Vibest Desktop Application",
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:unpack": "electron-builder --dir",
    "build:mac": "electron-builder --mac",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:headed": "playwright test -c e2e/playwright.config.ts --headed",
    "e2e:report": "playwright show-report e2e/report",
    "postinstall": "electron-builder install-app-deps",
    "clean": "git clean -xdf node_modules dist .turbo"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@electron-toolkit/utils": "^4.0.0",
    "@orpc/client": "catalog:orpc",
    "@orpc/contract": "catalog:orpc",
    "@orpc/experimental-effect": "catalog:orpc",
    "@orpc/server": "catalog:orpc",
    "@vibest/app": "workspace:*",
    "@vibest/cli": "workspace:*",
    "effect": "catalog:",
    "react-error-boundary": "catalog:"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@orpc/tanstack-query": "catalog:orpc",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vibest/ui": "workspace:*",
    "@vitejs/plugin-react": "catalog:",
    "clsx": "catalog:",
    "code-inspector-plugin": "latest",
    "dmg-builder": "26.4.0",
    "electron": "^41.10.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "lucide-react": "catalog:",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "p-queue": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  }
}
