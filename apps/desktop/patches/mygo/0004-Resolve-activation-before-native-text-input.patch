new file mode 100644
--- /dev/null
+++ b/ui/navigation_input.go
@@ -0,0 +1,53 @@
+package ui
+
+import "github.com/egoist/mygo/internal/platform"
+
+// ReleaseUnframed reports a release without running the next display frame.
+func (t *Tester) ReleaseUnframed(x, y float32) {
+	t.rt.event(platform.SurfaceEvent{Kind: platform.PointerUp, X: float64(x), Y: float64(y)})
+}
+
+// KeyUnframed reports a key without running the next display frame.
+func (t *Tester) KeyUnframed(mods Modifiers, key Key) {
+	t.rt.event(platform.SurfaceEvent{Kind: platform.KeyPressed, Key: platform.Key(key), Mods: platform.Modifiers(mods)})
+	t.rt.event(platform.SurfaceEvent{Kind: platform.KeyReleased, Key: platform.Key(key), Mods: platform.Modifiers(mods)})
+}
+
+// PressUnframed reports a press without supplying a display frame. Pending
+// activation may still render internally before this newer physical intent.
+func (t *Tester) PressUnframed(x, y float32) {
+	t.rt.event(platform.SurfaceEvent{Kind: platform.PointerDown, X: float64(x), Y: float64(y), Clicks: 1})
+}
+
+// CommitTextNative models an ordinary text commit without a keyDown or frame.
+func (t *Tester) CommitTextNative(text string) bool {
+	if t.rt.event(platform.SurfaceEvent{Kind: platform.SurfacePrepareInput}) {
+		t.Frame()
+	}
+	if !t.h.ime.Active {
+		return false
+	}
+	t.rt.event(platform.SurfaceEvent{Kind: platform.TextInput, Text: text})
+	return true
+}
+
+// CommandNative enters the production SurfaceCommand route, not a keyDown.
+func (t *Tester) CommandNative(name string) {
+	t.rt.event(platform.SurfaceEvent{Kind: platform.SurfaceCommand, Text: name})
+}
+
+// TypeKeyNative models Darwin's prepare-before-eligibility and plain-text commit.
+// The supplied text stands for the input method's commit, not a real IME run.
+func (t *Tester) TypeKeyNative(mods Modifiers, key Key, text string) bool {
+	if t.rt.event(platform.SurfaceEvent{Kind: platform.SurfacePrepareInput}) {
+		t.Frame()
+	}
+	active := t.h.ime.Active && mods&(Super|Ctrl) == 0
+	t.rt.event(platform.SurfaceEvent{Kind: platform.KeyPressed, Key: platform.Key(key), PhysicalKey: platform.Key(key), Mods: platform.Modifiers(mods)})
+	if active {
+		t.rt.event(platform.SurfaceEvent{Kind: platform.TextInput, Text: text})
+	}
+	t.rt.event(platform.SurfaceEvent{Kind: platform.KeyReleased, Key: platform.Key(key), PhysicalKey: platform.Key(key), Mods: platform.Modifiers(mods)})
+	t.Frame()
+	return active
+}
