+package ui
+
+import "testing"
+
+func TestModalReplacementKeepsFirstInputAndOriginalOpener(t *testing.T) {
+	for _, firstField := range []bool{true, false} {
+		label := "button-to-field"
+		if firstField {
+			label = "field-to-button"
+		}
+		t.Run(label, func(t *testing.T) {
+			open, field := true, firstField
+			value := ""
+			tt := coreNewTester(func(c *context) {
+				coreButton(c, "Opener").AutoFocus()
+				coreModal(c, &open, func() {
+					if field {
+						coreTextInput(c, &value).Label("Field")
+					}
+					if coreButton(c, "Cancel").Clicked() {
+						open = false
+					}
+				})
+			}, 400, 280)
+			field = !field
+			tt.Frame()
+			want := "Cancel"
+			if field {
+				want = "Field"
+			}
+			if !tt.Focused(want) {
+				t.Fatalf("first replacement frame did not focus %s", want)
+			}
+			if field {
+				tt.Type("x")
+				if value != "x" {
+					t.Fatalf("first text lost: %q", value)
+				}
+				tt.Key(0, KeyEscape)
+			} else {
+				tt.Key(0, KeyEnter)
+			}
+			if open || !tt.Focused("Opener") {
+				t.Fatal("replacement did not close to original opener")
+			}
+		})
+	}
+}
