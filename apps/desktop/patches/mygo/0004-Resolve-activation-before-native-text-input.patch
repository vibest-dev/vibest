+++ b/ui/input_prepare.go
@@ -0,0 +1,18 @@
+package ui
+
+import "github.com/egoist/mygo/internal/platform"
+
+// Use the existing surface-frame entry, not painting from an arbitrary native
+// callback. Headless probes use the same engine path without a native surface.
+func (rt *engine) prepareInputFrame() {
+	if rt.inFrame || !(rt.activationPending || len(rt.keys) > 0) {
+		return
+	}
+	if h, ok := rt.host.(*windowHost); ok {
+		if s, ok := h.conn.Surface.(platform.PacedSurface); ok {
+			s.FrameNow()
+		}
+	} else if _, ok := rt.host.(*headless); ok {
+		rt.runFrame()
+	}
+}
