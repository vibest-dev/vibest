+package ui
+
+import "testing"
+
+func TestTextSessionLossClearsMatchingCustomPreedit(t *testing.T) {
+	preedit := ""
+	cleared := 0
+	var owner uint64
+	tt := NewTester(func(c *Context) {
+		Row(c).Fill().Children(func() {
+			ButtonBase(c).Label("Control").Size(80, 30).Clicked()
+			Box(c).Key("terminal").Size(100, 30).Focusable().AutoFocus().TextCaret(Rect{W: 1, H: 16}).HandleInput(func(e InputEvent) bool {
+				if e.Kind == InputCompose {
+					if e.Text == "" {
+						if e.Session != owner {
+							t.Errorf("cancel delivered to wrong session: %d want %d", e.Session, owner)
+						}
+						cleared++
+					}
+					preedit = e.Text
+					owner = e.Session
+				}
+				return true
+			})
+		})
+	}, 240, 100)
+	tt.Compose("に", 1)
+	if preedit != "に" {
+		t.Fatal("preedit setup")
+	}
+	r, _ := tt.Find("Control")
+	tt.Press(r.X+5, r.Y+5)
+	tt.Release(-1, -1)
+	if preedit != "" || cleared != 1 || !tt.Focused("Control") {
+		t.Fatalf("focus loss retained custom preedit: %q clears=%d", preedit, cleared)
+	}
+}
