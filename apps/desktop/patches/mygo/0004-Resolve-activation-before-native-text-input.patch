--- /dev/null
+++ b/internal/darwin/navigation_input_test.go
@@ -0,0 +1,66 @@
+//go:build darwin
+
+package darwin
+
+import (
+	"github.com/egoist/mygo/internal/platform"
+	"os"
+	"strings"
+	"testing"
+)
+
+type navigationInputHandler struct {
+	platform.WindowHandler
+	s       *surface
+	pending bool
+	events  []platform.SurfaceEventKind
+}
+
+func (h *navigationInputHandler) SurfaceEvent(e platform.SurfaceEvent) bool {
+	h.events = append(h.events, e.Kind)
+	if e.Kind == platform.SurfacePrepareInput {
+		return h.pending
+	}
+	if e.Kind == platform.SurfaceFrame {
+		h.pending = false
+		h.s.input = platform.TextInputState{Active: true, Session: 2}
+	}
+	return false
+}
+
+func TestNativePrepareBeforeTextEligibility(t *testing.T) {
+	h := &navigationInputHandler{pending: true}
+	s := &surface{w: &window{h: h}}
+	h.s = s
+	s.prepareInput()
+	if !s.input.Active || s.input.Session != 2 || len(h.events) != 2 || h.events[0] != platform.SurfacePrepareInput || h.events[1] != platform.SurfaceFrame {
+		t.Fatal("activation not resolved before text state", h.events)
+	}
+	source, err := os.ReadFile("surface.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	body := strings.Split(strings.Split(string(source), `method("keyDown:",`)[1], `method("keyUp:"`)[0]
+	if strings.Index(body, "s.prepareInput()") > strings.Index(body, "text := s.input.Active") || !strings.Contains(body, "s.prepareInput()") {
+		t.Fatal("native keyDown captures stale text eligibility")
+	}
+}
+
+// These are supplied legitimate callbacks, not proof of a stale AppKit callback.
+func TestNativeCommitResolvesPendingSession(t *testing.T) {
+	for _, composition := range []bool{false, true} {
+		h := &navigationInputHandler{pending: true}
+		s := &surface{w: &window{h: h}, input: platform.TextInputState{Active: true, Session: 1}}
+		h.s = s
+		want := platform.TextInput
+		if composition {
+			s.setMarkedText("new", nsRange{}, nsRange{Location: nsNotFound})
+			want = platform.TextComposition
+		} else {
+			s.insertText("new", nsRange{Location: nsNotFound})
+		}
+		if len(h.events) != 3 || h.events[0] != platform.SurfacePrepareInput || h.events[1] != platform.SurfaceFrame || h.events[2] != want {
+			t.Fatal("legitimate commit/composition lost at ownership preflight", h.events)
+		}
+	}
+}
