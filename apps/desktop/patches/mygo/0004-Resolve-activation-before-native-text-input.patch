@@ -0,0 +1,89 @@
+package ui
+
+import "testing"
+
+func TestNativeInputResolvesQueuedActivation(t *testing.T) {
+	for _, how := range []string{"pointer", "enter", "shortcut"} {
+		t.Run(how, func(t *testing.T) {
+			selected := false
+			var got []string
+			tt := NewTester(func(c *Context) {
+				root := Row(c).Fill()
+				if root.Shortcut(Cmd, Key2) {
+					selected = true
+				}
+				root.Children(func() {
+					if ButtonBase(c).Label("Go").Size(60, 30).Clicked() {
+						selected = true
+					}
+					label := "old"
+					if selected {
+						label = "new"
+					}
+					Box(c).Key(label).Size(100, 30).Focusable().AutoFocus().TextCaret(Rect{W: 1, H: 16}).HandleInput(func(e InputEvent) bool {
+						if e.Kind == InputText {
+							got = append(got, label+":"+e.Text)
+						}
+						return true
+					})
+				})
+			}, 240, 100)
+			oldSession := tt.h.ime.Session
+			r, _ := tt.Find("Go")
+			x, y := r.X+r.W/2, r.Y+r.H/2
+			switch how {
+			case "pointer":
+				tt.Press(x, y)
+				tt.ReleaseUnframed(x, y)
+			case "enter":
+				tt.Press(x, y)
+				tt.Release(-1, -1)
+				tt.KeyUnframed(0, KeyEnter)
+			case "shortcut":
+				tt.KeyUnframed(Cmd, Key2)
+			}
+			if !tt.TypeKeyNative(0, KeyX, "x") {
+				t.Fatal("eligibility checked before activation")
+			}
+			if len(got) != 1 || got[0] != "new:x" {
+				t.Fatalf("first text routed to %v", got)
+			}
+			if tt.h.ime.Session == oldSession {
+				t.Fatal("native composition session retained old owner")
+			}
+		})
+	}
+}
+
+func TestCommitEntryResolvesOldTargetNegativeControl(t *testing.T) {
+	selected := false
+	var got string
+	tt := NewTester(func(c *Context) {
+		Row(c).Fill().Children(func() {
+			if ButtonBase(c).KeepFocus().Label("Go").Size(60, 30).Clicked() {
+				selected = true
+			}
+			label := "old"
+			if selected {
+				label = "new"
+			}
+			Box(c).Key(label).Size(100, 30).Focusable().AutoFocus().TextCaret(Rect{W: 1, H: 16}).HandleInput(func(e InputEvent) bool {
+				if e.Kind == InputText {
+					got = label + ":" + e.Text
+				}
+				return true
+			})
+		})
+	}, 240, 100)
+	r, _ := tt.Find("Go")
+	tt.Press(r.X+10, r.Y+10)
+	tt.ReleaseUnframed(r.X+10, r.Y+10)
+	if selected || !tt.h.ime.Active {
+		t.Fatal("old-target/active setup no longer distinguishes the unsafe baseline")
+	}
+	// Direct text commit (not keyDown) must resolve the pending activation.
+	tt.Type("x")
+	if got != "new:x" {
+		t.Fatalf("FIRST commit went to old target: %s", got)
+	}
+}
