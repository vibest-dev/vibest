diff --git a/ui/text_input_session_test.go b/ui/text_input_session_test.go
new file mode 100644
--- /dev/null
+++ b/ui/text_input_session_test.go
@@ -0,0 +1,43 @@
+package ui
+
+import "testing"
+
+func TestCustomTextOwnerKeepsWidgetAndCancelsOnlyOldPreedit(t *testing.T) {
+	owner := 1
+	x := float32(0)
+	preedit := ""
+	var session uint64
+	clears := 0
+	tt := NewTester(func(c *Context) {
+		Box(c).Key("terminal").Label("terminal").Size(100, 30).Focusable().AutoFocus().TextInputSession(owner).TextCaret(Rect{X: x, W: 1, H: 16}).HandleInput(func(e InputEvent) bool {
+			if e.Kind == InputCompose {
+				if e.Text == "" {
+					if e.Session != session {
+						t.Error("canceled another owner")
+					}
+					clears++
+				}
+				preedit = e.Text
+				session = e.Session
+			}
+			return true
+		})
+	}, 240, 100)
+	id := tt.rt.focused
+	tt.Compose("字", 1)
+	old := session
+	x = 12
+	tt.Frame()
+	if preedit != "字" || session != old || clears != 0 {
+		t.Fatal("caret change canceled composition")
+	}
+	owner++
+	tt.Frame()
+	if preedit != "" || clears != 1 || tt.rt.focused != id || !tt.Focused("terminal") {
+		t.Fatal("logical change failed cancellation or disturbed focus")
+	}
+	tt.Compose("新", 1)
+	if preedit != "新" || session == old {
+		t.Fatal("new owner cannot compose")
+	}
+}
