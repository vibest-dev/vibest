+// TextInputSession identifies the logical text owner without changing widget focus
+// or pointer identity. A changed key cancels only the previous composition.
+func (_handle Element) TextInputSession(key any) Element {
+	_node := _handle.node()
+	if _node == nil {
+		return Element{}
+	}
+	_ctx := _node.c
+	_ = _ctx
+	return wrapElement(_node.TextInputSession(key))
+}
