diff --git a/ui/input_owner_prepare_test.go b/ui/input_owner_prepare_test.go
new file mode 100644
--- /dev/null
+++ b/ui/input_owner_prepare_test.go
@@ -0,0 +1,67 @@
+package ui
+
+import (
+	"github.com/egoist/mygo/internal/platform"
+	"testing"
+)
+
+func TestLogicalOwnerPreparationNoKeysAndStableWidget(t *testing.T) {
+	owner := 1
+	queries := 0
+	preedit := ""
+	text := ""
+	tt := NewTester(func(c *Context) {
+		built := owner
+		Box(c).Key("terminal").Label("terminal").Size(100, 30).Focusable().AutoFocus().TextInputSession(owner).PrepareInput(func() bool { queries++; return owner != built }).TextCaret(Rect{W: 1, H: 16}).HandleInput(func(e InputEvent) bool {
+			if e.Kind == InputCompose {
+				preedit = e.Text
+			}
+			if e.Kind == InputText {
+				text += e.Text
+			}
+			return true
+		})
+	}, 240, 100)
+	tt.Compose("字", 1)
+	oldSession := tt.h.ime.Session
+	oldFocus := tt.rt.focused
+	frame := tt.rt.frame
+	if len(tt.rt.keys) != 0 || tt.rt.activationPending {
+		t.Fatal("need no queued physical intent")
+	}
+	if tt.rt.event(platform.SurfaceEvent{Kind: platform.SurfacePrepareInput}) || tt.rt.frame != frame {
+		t.Fatal("unchanged owner forced a frame")
+	}
+	owner++
+	tt.rt.inFrame = true
+	count := queries
+	if tt.rt.event(platform.SurfaceEvent{Kind: platform.SurfacePrepareInput}) {
+		t.Fatal("reentrant prepare")
+	}
+	tt.rt.prepareInputFrame()
+	if queries != count || tt.rt.frame != frame {
+		t.Fatal("reentrant model query/frame")
+	}
+	tt.rt.inFrame = false
+	if !tt.rt.event(platform.SurfaceEvent{Kind: platform.SurfacePrepareInput}) || tt.rt.frame != frame {
+		t.Fatal("model change not requested via existing frame path")
+	}
+	tt.rt.prepareInputFrame()
+	if tt.rt.frame != frame+1 || tt.rt.focused != oldFocus || tt.h.ime.Session == oldSession || preedit != "" {
+		t.Fatal("owner not reconciled once without refocus")
+	}
+	// A text event explicitly prepared for the retired owner cannot be retargeted.
+	tt.rt.event(platform.SurfaceEvent{Kind: platform.TextInput, Text: "old", Session: oldSession})
+	if text != "" {
+		t.Fatal("retired prepared owner delivered text")
+	}
+	tt.rt.event(platform.SurfaceEvent{Kind: platform.TextInput, Text: "new", Session: tt.h.ime.Session})
+	if text != "new" {
+		t.Fatal("legitimate fresh commit rejected")
+	}
+	owner++
+	tt.rt.event(platform.SurfaceEvent{Kind: platform.TextInput, Text: "fresh"})
+	if text != "newfresh" {
+		t.Fatal("fresh untagged common entry dropped instead of preparing its owner")
+	}
+}
