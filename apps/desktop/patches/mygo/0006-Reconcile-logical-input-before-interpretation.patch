+// PrepareInput requests an existing surface frame before input when the focused
+// element's model changed. The query runs outside View and must not reenter UI.
+func (_handle Element) PrepareInput(changed func() bool) Element {
+	_node := _handle.node()
+	if _node == nil {
+		return Element{}
+	}
+	_ctx := _node.c
+	_ = _ctx
+	return wrapElement(_node.PrepareInput(changed))
+}
