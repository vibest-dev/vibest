+// CancelInput drops queued bytes, deferred paste/clipboard captures and local
+// composition. Call on the UI thread when logical input ownership changes;
+// captured writers must also reject an already-dequeued stale entry.
+func (t *Terminal) CancelInput() {
+	t.mu.Lock()
+	t.offer, t.clipReads, t.replying = nil, nil, false
+	t.in.mu.Lock()
+	t.in.queue, t.in.bytes = nil, 0
+	t.in.mu.Unlock()
+	t.mu.Unlock()
+	if v := t.v; v != nil {
+		v.preedit, v.pending = "", nil
+		v.reads, v.clipPrompt, v.clipOpen = nil, nil, false
+	}
+}
 
