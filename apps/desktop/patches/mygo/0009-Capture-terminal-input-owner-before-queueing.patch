@@ -0,0 +1,137 @@
+package terminal
+
+import (
+	"bytes"
+	"github.com/egoist/mygo/transfer"
+	"io"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type capturedWriter struct {
+	generation *atomic.Uint64
+	captured   uint64
+	out        io.Writer
+}
+
+func (w capturedWriter) Write(p []byte) (int, error) {
+	if w.generation.Load() != w.captured {
+		return 0, ErrInputCanceled
+	}
+	return w.out.Write(p)
+}
+func TestCapturedInputDoesNotReviveAfterOwnerReturns(t *testing.T) {
+	var generation atomic.Uint64
+	var out bytes.Buffer
+	generation.Store(1)
+	q := inputQueue{capture: func() io.Writer { return capturedWriter{&generation, generation.Load(), &out} }}
+	q.push([]byte("stale"))
+	generation.Store(3) // focus left and returned before the writer dequeued
+	q.push([]byte("current"))
+	done := make(chan struct{})
+	q.pushDone(nil, func() { close(done) })
+	go q.run(io.Discard)
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("queue stopped on canceled entry")
+	}
+	q.close()
+	if out.String() != "current" {
+		t.Fatal(out.String())
+	}
+}
+func TestCapturedInputBoundsAndCancel(t *testing.T) {
+	term := &Terminal{offer: &pasteOffer{}}
+	term.in.capture = func() io.Writer { return io.Discard }
+	q := &term.in
+	q.push(make([]byte, 1<<20))
+	q.push([]byte("overflow"))
+	if len(q.queue) != 1 || q.bytes != 1<<20 {
+		t.Fatal("unbounded owner queue")
+	}
+	term.CancelInput()
+	if len(term.in.queue) != 0 || term.in.bytes != 0 || term.offer != nil {
+		t.Fatal("captures survived cancel")
+	}
+}
+
+// A recoverable capacity refusal must neither claim delivery nor poison the FIFO.
+type busyOnce struct {
+	calls int
+	out   bytes.Buffer
+}
+
+func (w *busyOnce) Write(p []byte) (int, error) {
+	w.calls++
+	if w.calls == 1 {
+		return 0, ErrInputFull
+	}
+	return w.out.Write(p)
+}
+func TestCapturedInputCapacityRefusalKeepsQueueUsable(t *testing.T) {
+	w := &busyOnce{}
+	refused := make(chan error, 2)
+	delivered := make(chan struct{}, 1)
+	q := inputQueue{capture: func() io.Writer { return w }, onError: func(err error) { refused <- err }}
+	q.pushDone([]byte("refused"), func() { delivered <- struct{}{} })
+	go q.run(io.Discard)
+	defer q.close()
+	select {
+	case err := <-refused:
+		if err != ErrInputFull {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("silent refusal")
+	}
+	done := make(chan struct{})
+	q.pushDone([]byte("current"), func() { close(done) })
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("capacity permanently stopped input")
+	}
+	if w.out.String() != "current" {
+		t.Fatal(w.out.String())
+	}
+	select {
+	case <-delivered:
+		t.Fatal("refused input claimed delivery")
+	default:
+	}
+}
+func TestCapturedInputPayloadLimitReportsOverflow(t *testing.T) {
+	rejected := 0
+	q := inputQueue{limit: (1 << 20) - 9, capture: func() io.Writer { return io.Discard }, onError: func(err error) {
+		if err != ErrInputFull {
+			t.Fatal(err)
+		}
+		rejected++
+	}}
+	for _, size := range []int{1 << 20, (1 << 20) + 1} {
+		if q.pushDone(make([]byte, size), nil) {
+			t.Fatal("oversized payload accepted")
+		}
+	}
+	if rejected != 2 || !q.pushDone([]byte("next"), nil) {
+		t.Fatal("silent overflow or poisoned queue")
+	}
+}
+
+func TestCapturedInputFileDropHonorsPasteRefusal(t *testing.T) {
+	called := false
+	term := &Terminal{opts: Options{OnPaste: func(d transfer.Data) bool {
+		files, err := d.Files()
+		if err != nil || len(files) != 1 || files[0] != "/inert/not-read" {
+			t.Fatalf("bad file offer: %v %v", files, err)
+		}
+		called = true
+		return true
+	}}}
+	term.dropFiles([]string{"/inert/not-read"})
+	if !called || len(term.in.queue) != 0 {
+		t.Fatal("drop bypassed existing paste policy")
+	}
+}
