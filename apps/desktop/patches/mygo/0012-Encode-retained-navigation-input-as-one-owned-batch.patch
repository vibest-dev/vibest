diff --git a/plugins/terminal/input_batch.go b/plugins/terminal/input_batch.go
new file mode 100644
index 0000000..bef86ab
--- /dev/null
+++ b/plugins/terminal/input_batch.go
@@ -0,0 +1,86 @@
+package terminal
+
+import (
+	"github.com/egoist/mygo/plugins/terminal/internal/vt"
+	"github.com/egoist/mygo/ui"
+)
+
+// Input retains a human key/text event before a destination view is ready.
+// Paste marks InputText as already-snapshotted paste text, never a clipboard read.
+type Input struct {
+	ui.InputEvent
+	Paste bool
+}
+
+// SendInput encodes retained events with this view's current parsed modes and
+// enqueues one atomic batch ahead of later input. The caller must first validate
+// the original destination; CaptureInput still supplies the dispatch-time lease.
+// UI thread only. It does not run application shortcuts or terminal key bindings.
+func (t *Terminal) SendInput(events []Input) bool {
+	if t.v == nil {
+		return false
+	}
+	limit := t.in.limit
+	if limit <= 0 {
+		limit = 1 << 20
+	}
+	if len(events) > 4096 {
+		return false
+	}
+	v := *t.v
+	defer func() { t.v.keys = v.keys }()
+	v.batch = make([]byte, 0)
+	v.batchLimit = limit
+	v.batchFull = false
+	for _, e := range events {
+		if len(e.Text) > limit {
+			return false
+		}
+		if e.Paste {
+			t.mu.Lock()
+			if t.term == nil {
+				t.mu.Unlock()
+				return false
+			}
+			data := vt.EncodePaste(e.Text, t.term.Mode(vt.ModeBracketedPaste))
+			t.mu.Unlock()
+			v.sendInput(data)
+		} else {
+			switch e.Kind {
+			case ui.InputText:
+				if e.Key != ui.KeyUnknown {
+					key := e.InputEvent
+					key.Kind = ui.InputKeyDown
+					v.terminalKeyDown(key)
+				}
+				v.typed(e.Text)
+			case ui.InputKeyDown:
+				v.terminalKeyDown(e.InputEvent)
+			case ui.InputKeyUp:
+				v.keyUp(e.InputEvent)
+			default:
+				return false
+			}
+		}
+		if v.batchFull {
+			return false
+		}
+	}
+	if len(v.batch) > 0 && !t.in.pushDone(v.batch, nil) {
+		return false
+	}
+	t.v.pending = v.pending
+	t.v.keys = v.keys
+	return true
+}
+func (v *view) sendInput(p []byte) {
+	if v.batch != nil {
+		if len(v.batch)+len(p) > v.batchLimit {
+			v.batchFull = true
+			return
+		}
+		v.batch = append(v.batch, p...)
+		return
+	}
+	v.t.in.push(append([]byte(nil), p...))
+}
diff --git a/plugins/terminal/input_batch_test.go b/plugins/terminal/input_batch_test.go
new file mode 100644
index 0000000..ad61770
--- /dev/null
+++ b/plugins/terminal/input_batch_test.go
@@ -0,0 +1,56 @@
+package terminal
+
+import (
+	"github.com/egoist/mygo/ui"
+	"io"
+	"os"
+	"testing"
+)
+
+func TestCapturedNavigationBatchUsesParsedModesAndFIFO(t *testing.T) {
+	if os.Getenv("MYGO_GHOSTTY_VT") == "" {
+		t.Fatal("explicit verified software VT library required")
+	}
+	loadLib(t)
+	conn := newPipe()
+	term, err := New(Options{Conn: conn, CaptureInput: func() io.Writer { return conn }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer term.Close()
+	tt := ui.NewTester(func(c *ui.Context) { View(c, term).Fill().AutoFocus() }, 400, 200)
+	tt.Frame()
+	term.Feed([]byte("\x1b[?1h\x1b[?2004h"))
+	events := []Input{{InputEvent: ui.InputEvent{Kind: ui.InputText, Key: ui.KeyA, Mods: ui.Shift, Text: "A"}}, {InputEvent: ui.InputEvent{Kind: ui.InputKeyDown, Key: ui.KeyUp}}, {InputEvent: ui.InputEvent{Kind: ui.InputText, Text: "one\ntwo"}, Paste: true}}
+	if !term.SendInput(events) {
+		t.Fatal("batch rejected")
+	}
+	tt.Type("after")
+	if got := conn.take(term); got != "A\x1bOA\x1b[200~one\ntwo\x1b[201~after" {
+		t.Fatalf("encoded/order=%q", got)
+	}
+}
+func TestCapturedNavigationBatchRejectsWholePrefix(t *testing.T) {
+	if os.Getenv("MYGO_GHOSTTY_VT") == "" {
+		t.Fatal("explicit verified software VT library required")
+	}
+	loadLib(t)
+	conn := newPipe()
+	term, err := New(Options{Conn: conn, InputLimit: 4, CaptureInput: func() io.Writer { return conn }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer term.Close()
+	tt := ui.NewTester(func(c *ui.Context) { View(c, term).Fill().AutoFocus() }, 400, 200)
+	tt.Frame()
+	if term.SendInput([]Input{{InputEvent: ui.InputEvent{Kind: ui.InputText, Text: "abc"}}, {InputEvent: ui.InputEvent{Kind: ui.InputText, Text: "def"}}}) {
+		t.Fatal("oversize batch accepted")
+	}
+	if got := conn.take(term); got != "" {
+		t.Fatalf("prefix escaped: %q", got)
+	}
+	tt.Type("ok")
+	if got := conn.take(term); got != "ok" {
+		t.Fatalf("refusal poisoned later input: %q", got)
+	}
+}
