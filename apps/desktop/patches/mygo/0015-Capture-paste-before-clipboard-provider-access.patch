@@ -0,0 +1,59 @@
+package terminal
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/egoist/mygo/transfer"
+	"github.com/egoist/mygo/ui"
+)
+
+func TestCapturedInputPreparePastePrecedesProvider(t *testing.T) {
+	for _, eager := range []bool{false, true} {
+		t.Run(map[bool]string{false: "lazy", true: "eager"}[eager], func(t *testing.T) {
+			var services ui.Services
+			tt := ui.NewTester(func(c *ui.Context) { services = c.Services() }, 100, 100)
+			tt.SetClipboardEager(eager)
+			var steps []string
+			tt.SetClipboardData(transfer.New(transfer.NewItem(transfer.Lazy(transfer.FileList, func() ([]byte, error) {
+				steps = append(steps, "provider")
+				return []byte("file:///inert/provider"), nil
+			}))))
+			term := &Terminal{opts: Options{PreparePaste: func() func(transfer.Data) bool {
+				steps = append(steps, "capture")
+				return func(d transfer.Data) bool {
+					steps = append(steps, "handler")
+					if _, err := d.Read(transfer.FileList); err != nil {
+						t.Fatal(err)
+					}
+					return true
+				}
+			}, OnPaste: func(transfer.Data) bool { t.Fatal("prepared paste recaptured through OnPaste"); return true }}}
+			v := &view{t: term, services: services}
+			if !v.paste() {
+				t.Fatal("paste was not consumed")
+			}
+			want := []string{"capture", "handler", "provider"}
+			if eager {
+				want = []string{"capture", "provider", "handler"}
+			}
+			if !reflect.DeepEqual(steps, want) {
+				t.Fatal("capture/provider order", steps, want)
+			}
+		})
+	}
+}
+
+func TestCapturedInputPreparePasteRefusesBeforeProvider(t *testing.T) {
+	var services ui.Services
+	tt := ui.NewTester(func(c *ui.Context) { services = c.Services() }, 100, 100)
+	tt.SetClipboardEager(true)
+	tt.SetClipboardData(transfer.New(transfer.NewItem(transfer.Lazy(transfer.FileList, func() ([]byte, error) { t.Fatal("refusal read clipboard provider"); return nil, nil }))))
+	term := &Terminal{opts: Options{PreparePaste: func() func(transfer.Data) bool { return nil }, OnPaste: func(transfer.Data) bool { t.Fatal("refusal fell back to OnPaste"); return false }}}
+	if !(&view{t: term, services: services}).paste() {
+		t.Fatal("refusal not consumed")
+	}
+	if len(term.in.queue) != 0 {
+		t.Fatal("refusal sent input")
+	}
+}
