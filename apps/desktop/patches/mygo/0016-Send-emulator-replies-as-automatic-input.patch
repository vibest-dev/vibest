@@ -0,0 +1,57 @@
+package terminal
+
+import (
+	"bytes"
+	"io"
+	"testing"
+	"time"
+)
+
+type kindWriter struct{ out *bytes.Buffer }
+
+func (w kindWriter) Write(p []byte) (int, error) {
+	w.out.WriteString("D:" + string(p) + ";")
+	return len(p), nil
+}
+
+func (w kindWriter) WriteAutomatic(p []byte) (int, error) {
+	w.out.WriteString("A:" + string(p) + ";")
+	return len(p), nil
+}
+
+func TestEmulatorRepliesGoAsAutomaticInputInOrderWithTyping(t *testing.T) {
+	var out bytes.Buffer
+	q := inputQueue{capture: func() io.Writer { return kindWriter{&out} }}
+	q.push([]byte("a"))
+	q.pushAutomatic([]byte("\x1b[48;24;80t"))
+	done := make(chan struct{})
+	q.pushDone([]byte("b"), func() { close(done) })
+	go q.run(io.Discard)
+	defer q.close()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("queue blocked")
+	}
+	if out.String() != "D:a;A:\x1b[48;24;80t;D:b;" {
+		t.Fatalf("got %q", out.String())
+	}
+}
+
+func TestEmulatorRepliesFallBackToWriteWithoutAutomaticWriter(t *testing.T) {
+	var out bytes.Buffer
+	q := inputQueue{capture: func() io.Writer { return &out }}
+	q.pushAutomatic([]byte("r"))
+	done := make(chan struct{})
+	q.pushDone([]byte("k"), func() { close(done) })
+	go q.run(io.Discard)
+	defer q.close()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("queue blocked")
+	}
+	if out.String() != "rk" {
+		t.Fatalf("got %q", out.String())
+	}
+}
