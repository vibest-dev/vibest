 }
+
+func TestEmulatorRepliesUseTheirOwnCaptureWithoutTheKeyboard(t *testing.T) {
+	var out bytes.Buffer
+	q := inputQueue{capture: func() io.Writer { return nil }, automatic: func() io.Writer { return kindWriter{&out} }}
+	if q.pushDone([]byte("typed without an owner"), nil) {
+		t.Fatal("typing without an owner was queued")
+	}
+	done := make(chan struct{})
+	q.pushAutomatic([]byte("\x1b[?62c"))
+	q.pushOwned(nil, func() { close(done) }, kindWriter{&out})
+	go q.run(io.Discard)
+	defer q.close()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("queue blocked")
+	}
+	if out.String() != "A:\x1b[?62c;D:;" {
+		t.Fatalf("got %q", out.String())
+	}
+}
