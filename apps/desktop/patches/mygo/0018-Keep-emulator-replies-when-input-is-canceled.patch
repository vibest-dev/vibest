+
+func TestCancelingInputKeepsQueuedEmulatorReplies(t *testing.T) {
+	var out bytes.Buffer
+	term := &Terminal{}
+	term.in.capture = func() io.Writer { return kindWriter{&out} }
+	term.in.push([]byte("typed"))
+	term.in.pushAutomatic([]byte("\x1b[?62c"))
+	term.in.push([]byte("more"))
+	term.CancelInput()
+	done := make(chan struct{})
+	term.in.pushOwned(nil, func() { close(done) }, kindWriter{&out})
+	go term.in.run(io.Discard)
+	defer term.in.close()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("queue blocked")
+	}
+	if out.String() != "A:\x1b[?62c;D:;" {
+		t.Fatalf("got %q", out.String())
+	}
+}
