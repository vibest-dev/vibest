+// GraphicsGeneration changes when image storage or placements change.
+func (t *Terminal) GraphicsGeneration() uint64 {
+	var generation uint64
+	if g := t.graphics(); g != 0 {
+		call(fnKittyGet, g, kittyGeneration, uintptr(unsafe.Pointer(&generation)))
+	}
