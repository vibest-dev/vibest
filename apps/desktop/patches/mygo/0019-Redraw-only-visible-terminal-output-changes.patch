+// SetVisible controls output-driven frame requests, not parsing or callbacks.
+// Terminals are visible by default. Hosts hiding a retained View must call
+// SetVisible(false); showing it again requests its accumulated state at once.
+func (t *Terminal) SetVisible(visible bool) {
+	if t.hidden.Swap(!visible) && visible {
+		t.redraw()
+	}
+}
+
+// outputChanged updates the shared snapshot without cleaning its dirty rows.
+// t.mu is held; paint alone consumes the pending changes.
+func (t *Terminal) outputChanged() bool {
+	t.rmu.Lock()
+	defer t.rmu.Unlock()
+	if t.held || t.rs == nil {
+		return false
+	}
+	if err := t.rs.Update(t.term); err != nil {
+		return true
+	}
+	return t.rs.Dirty() != vt.Clean || t.rs.Cursor() != t.drawnCursor ||
+		t.rs.Colors() != t.drawnColors || t.term.GraphicsGeneration() != t.drawnImages
 }
 
