+// menuEnterShift is how far c still has to travel for a Flip entrance.
+// Zero unless that entrance fades in.
+func menuEnterShift(c *node) (float32, float32) {
+	rt := c.c.rt
+	if rt.trans == nil {
+		return 0, 0
+	}
+	r := rt.trans[c.id]
+	if r == nil || r.t.Enter == nil || !r.t.Enter.Flip || r.target.alpha <= 0 {
+		return 0, 0
+	}
+	remain := float32(1 - r.shown.alpha/r.target.alpha)
+	if remain == 0 {
+		return 0, 0
+	}
+	m := r.t.Enter
+	dx, dy := m.X, m.Y
+	if c.flips&flipAcross != 0 {
+		dx = -dx
+	}
+	if c.flips&flipDown != 0 {
+		dy = -dy
+	}
+	return dx * remain, dy * remain
+}
+
