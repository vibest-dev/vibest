@@ -0,0 +1,141 @@
+package ui
+
+import (
+	"slices"
+
+	"github.com/egoist/mygo/internal/platform"
+)
+
+// MenuPainter is an app's look for menus drawn in the window
+// (SetMenuPresentation). The toolkit still places the menu, moves the
+// highlight, and dismisses it (MenuBase).
+type MenuPainter struct {
+	// Panel styles the menu card. Level is 0 for the menu and 1 for a
+	// submenu, and so on.
+	Panel func(panel Element, info MenuPaint)
+	// Item styles one row. The row already reports Highlighted, Clicked
+	// and Disabled, and assistive technology already knows its name.
+	Item func(row Element, it MenuPaintItem)
+	// Separator is a line between items, drawn into the panel.
+	Separator func()
+}
+
+// MenuPaint describes the menu Panel is styling.
+type MenuPaint struct {
+	// Edit is the editing menu of a text input or selectable text.
+	Edit bool
+	// Below is a menu button's menu, opening under the button.
+	Below bool
+	// Level is 0 for the menu and greater for a submenu.
+	Level int
+	// TriggerLabel and TriggerWidget name the element the menu opened on.
+	TriggerLabel  string
+	TriggerWidget string
+}
+
+// MenuPaintItem is one entry of a menu the window draws.
+type MenuPaintItem struct {
+	ID       int
+	Label    string
+	Shortcut string
+	Tooltip  string
+	Enabled  bool
+	Checked  bool
+	Radio    bool
+	Submenu  bool
+	// Marks is set when this menu reserves a column for check marks.
+	Marks bool
+}
+
+// SetMenuPainter sets the look of menus drawn in the window. It stays
+// until set again. A zero Panel keeps the theme's menu look.
+func (c *context) SetMenuPainter(p MenuPainter) {
+	c.rt.menu.paint = p
+}
+
+func paintDrawnMenu(m *menuParts, d *drawnMenu, e *node, pm *platform.Menu, run *menuRun, build func(*Menu), open *bool) {
+	rt := m.c.rt
+	paint := rt.menu.paint
+	var chosen *platform.MenuItem
+	info := MenuPaint{Edit: d.edit, Below: d.menu.below, TriggerLabel: e.label, TriggerWidget: e.widget}
+	var items func(list []*platform.MenuItem, level int)
+	items = func(list []*platform.MenuItem, level int) {
+		marks := slices.ContainsFunc(list, func(it *platform.MenuItem) bool {
+			return it.Visible && (it.Type == platform.MenuItemCheckbox || it.Type == platform.MenuItemRadio)
+		})
+		for _, it := range list {
+			if !it.Visible {
+				continue
+			}
+			if it.Type == platform.MenuItemSeparator {
+				if paint.Separator != nil {
+					paint.Separator()
+				}
+				continue
+			}
+			row := paintedMenuRow(m, it)
+			if paint.Item != nil {
+				paint.Item(wrapElement(row), menuPaintItem(it, marks))
+			}
+			if sub := it.Submenu; it.Type == platform.MenuItemSubmenu && sub != nil {
+				subItems := sub.Items
+				next := level + 1
+				m.Submenu(row, func(panel *node) {
+					info.Level = next
+					paint.Panel(wrapElement(panel), info)
+					items(subItems, next)
+				})
+			} else if row.Clicked() {
+				chosen = it
+			}
+		}
+	}
+	m.Popup(func(panel *node) {
+		info.Level = 0
+		paint.Panel(wrapElement(panel), info)
+		items(pm.Items, 0)
+	})
+	if !*open {
+		rt.menu.drawn = nil
+	} else if d.menu.below {
+		e.expanded = true
+	}
+	if chosen != nil {
+		rt.drawnChoice(d, run, build, chosen)
+	}
+}
+
+func paintedMenuRow(m *menuParts, it *platform.MenuItem) *node {
+	sub := it.Type == platform.MenuItemSubmenu && it.Submenu != nil
+	var row *node
+	switch {
+	case sub:
+		row = m.SubmenuItem()
+	case it.Type == platform.MenuItemCheckbox:
+		row = m.CheckItem(it.Checked)
+	case it.Type == platform.MenuItemRadio:
+		row = m.RadioItem(it.Checked)
+	default:
+		row = m.Item()
+	}
+	row.Label(it.Label).Disabled(!it.Enabled)
+	if it.ToolTip != "" {
+		row.Tooltip(it.ToolTip)
+	}
+	row.keyShortcuts = shortcutText(it.Accelerator)
+	return row
+}
+
+func menuPaintItem(it *platform.MenuItem, marks bool) MenuPaintItem {
+	return MenuPaintItem{
+		ID:       it.ID,
+		Label:    it.Label,
+		Shortcut: shortcutText(it.Accelerator),
+		Tooltip:  it.ToolTip,
+		Enabled:  it.Enabled,
+		Checked:  it.Checked,
+		Radio:    it.Type == platform.MenuItemRadio,
+		Submenu:  it.Type == platform.MenuItemSubmenu && it.Submenu != nil,
+		Marks:    marks,
+	}
+}
