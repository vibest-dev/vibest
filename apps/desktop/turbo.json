{
  "$schema": "https://turborepo.com/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "dependsOn": ["@vibest/server#build"],
      "passThroughEnv": [
        "ANTIGRAVITY_AGENT",
        "ANTIGRAVITY_TRAJECTORY_ID",
        "BOLT_ENV",
        "BOLT_ORIGIN",
        "BOLT_SERVER_URL",
        "CLAUDECODE",
        "CLAUDE_CODE_SESSION_ID",
        "CLINE_WRAPPER_PATH",
        "CODEX_CI",
        "CODEX_SHELL",
        "CODEX_THREAD_ID",
        "COPILOT_AGENT_SESSION_ID",
        "COPILOT_CLI",
        "COPILOT_RUN_APP",
        "CURSOR_AGENT",
        "CURSOR_CONVERSATION_ID",
        "GEMINI_CLI",
        "KIRO_SESSION_ID",
        "KILO",
        "KILOCODE_VERSION",
        "KILO_RUN_ID",
        "PI_CODING_AGENT",
        "REPLIT_SESSION",
        "RORK_API_URL",
        "ANTHROPIC_*",
        "CLAUDE_*",
        "AWS_*",
        "AZURE_*",
        "GOOGLE_*",
        "VERTEX_*",
        "CLOUD_ML_*",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "all_proxy",
        "no_proxy",
        "NODE_EXTRA_CA_CERTS",
        "SSL_CERT_FILE",
        "SSL_CERT_DIR",
        "VIBEST_CLAUDE_EXECUTABLE",
        "VIBEST_HOME",
        "VIBEST_DAEMON_DIR"
      ]
    },
    "build:unpack": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "build:mac": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "e2e": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "e2e:headed": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "e2e:report": {
      "cache": false,
      "persistent": true
    }
  }
}
