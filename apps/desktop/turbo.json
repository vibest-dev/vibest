{
  "$schema": "https://turborepo.com/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "dependsOn": ["@vibest/server#build"],
      "passThroughEnv": ["*"]
    },
    "build:unpack": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "build:mac": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "e2e": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "e2e:headed": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "e2e:report": {
      "cache": false,
      "persistent": true
    }
  }
}
