{
  "$schema": "https://turborepo.com/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "dependsOn": ["@vibest/cli#build"],
      "passThroughEnv": [
        "ANTHROPIC_*",
        "CLAUDE_*",
        "AWS_*",
        "AZURE_*",
        "GOOGLE_*",
        "VERTEX_*",
        "CLOUD_ML_*",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "all_proxy",
        "no_proxy",
        "NODE_EXTRA_CA_CERTS",
        "SSL_CERT_FILE",
        "SSL_CERT_DIR",
        "VIBEST_CLAUDE_EXECUTABLE"
      ]
    },
    "build:unpack": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "build:mac": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "e2e": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "e2e:headed": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "e2e:report": {
      "cache": false,
      "persistent": true
    }
  }
}
