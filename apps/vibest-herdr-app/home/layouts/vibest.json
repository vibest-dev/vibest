{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [16, 19],
  "preview": "layouts/vibest.svg",
  "theme": { "light": "vibest-light", "dark": "vibest-dark" },
  "terminal_padding": [12, 12],
  "background": "background",
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 256 },
      "min": 208,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "sidebar-header",
          "type": "block",
          "size": { "px": 52 },
          "window_drag": true,
          "content": { "mod": "vibest", "props": { "part": "header" } }
        },
        { "id": "sidebar-threads", "type": "block", "content": { "mod": "vibest", "props": { "part": "threads" } } },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": { "px": 48 },
          "content": { "mod": "vibest", "props": { "part": "footer" } }
        }
      ]
    },
    {
      "id": "workspace",
      "type": "column",
      "resizable": false,
      "background": "background",
      "children": [
        {
          "id": "topbar",
          "type": "block",
          "size": { "px": 52 },
          "window_drag": true,
          "content": { "mod": "vibest", "props": { "part": "topbar" } }
        },
        {
          "id": "workspace-body",
          "type": "row",
          "divider": { "width": 1, "color": "border" },
          "children": [
            {
              "id": "terminals",
              "type": "block",
              "padding": 8,
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 8,
                  "background": "background",
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "input" },
                  "lone": false
                }
              }
            },
            {
              "id": "right-panel",
              "type": "stack",
              "hidden": true,
              "size": { "px": 540 },
              "min": 360,
              "max": 900,
              "active": "changes",
              "children": [
                { "id": "changes", "type": "block", "content": { "mod": "changes" } },
                { "id": "files", "type": "block", "content": { "mod": "files" } },
                { "id": "agents", "type": "block", "content": { "mod": "vibest", "props": { "part": "agents" } } }
              ]
            }
          ]
        }
      ]
    }
  ]
}
