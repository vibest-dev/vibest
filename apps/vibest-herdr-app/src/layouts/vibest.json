{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "theme": {
    "light": "vibest-light",
    "dark": "vibest-dark"
  },
  "traffic_lights": [13, 12],
  "preview": "layouts/vibest.svg",
  "terminal_padding": [4, 4],
  "background": "chrome",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 256
      },
      "min": 208,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "sidebar-header",
          "type": "block",
          "size": {
            "px": 32
          },
          "window_drag": true,
          "content": {
            "mod": "vibest-sidebar-header"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "projects",
              "type": "block",
              "size": {
                "weight": 3
              },
              "content": {
                "mod": "vibest-projects"
              },
              "min": 128
            },
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 2
              },
              "min": 90,
              "content": {
                "mod": "vibest-spaces"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 32
          },
          "content": {
            "mod": "vibest-sidebar-footer"
          }
        }
      ]
    },
    {
      "id": "left-gutter",
      "type": "column",
      "size": {
        "px": 4
      },
      "hidden": true,
      "children": []
    },
    {
      "id": "workspace",
      "type": "column",
      "resizable": false,
      "background": "chrome",
      "children": [
        {
          "id": "topbar",
          "type": "block",
          "size": {
            "px": 32
          },
          "window_drag": true,
          "content": {
            "mod": "vibest-topbar"
          }
        },
        {
          "id": "workspace-body",
          "type": "row",
          "padding": [4, 0],
          "gap": 4,
          "children": [
            {
              "id": "main",
              "type": "stack",
              "active": "terminals",
              "children": [
                {
                  "id": "terminals",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 4,
                      "radius": 8,
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "border"
                      },
                      "lone": true,
                      "header": {
                        "content": {
                          "mod": "vibest-pane"
                        },
                        "height": 32,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  }
                },
                {
                  "id": "start",
                  "type": "block",
                  "radius": 8,
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "content": {
                    "mod": "vibest-start"
                  }
                }
              ]
            },
            {
              "id": "right-panel",
              "type": "stack",
              "hidden": false,
              "size": {
                "px": 360
              },
              "min": 360,
              "max": 900,
              "active": "agents",
              "children": [
                {
                  "id": "changes",
                  "type": "block",
                  "content": {
                    "mod": "changes"
                  }
                },
                {
                  "id": "files",
                  "type": "block",
                  "content": {
                    "mod": "vibest-files"
                  }
                },
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "vibest-agents"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "right-gutter",
      "type": "column",
      "size": {
        "px": 4
      },
      "children": []
    }
  ],
  "gap": 0
}
