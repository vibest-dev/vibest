{
  "name": "vibest",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "watch": "turbo watch dev",
    "stub": "turbo watch stub",
    "build": "turbo build",
    "build:packages": "turbo build --filter=./packages/*",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "oxlint --fix",
    "lint:check": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run lint:check && pnpm run format:check && pnpm run typecheck",
    "clean": "turbo run clean && git clean -xdf node_modules dist .turbo",
    "bump": "pnpm taze",
    "sherif": "pnpm dlx sherif --fix",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepublish": "turbo build --filter=./packages/*",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks",
    "doctor": "react-doctor --yes",
    "doctor:staged": "for d in apps/desktop apps/web packages/ui; do (cd \"$d\" && npx --no-install react-doctor --staged --blocking error) || exit 1; done"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@types/node": "^24.10.13",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "publint": "^0.3.12",
    "react-doctor": "^0.7.6",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.5.0",
    "turbo": "^2.5.8",
    "typescript": "^7.0.2",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged && pnpm run doctor:staged"
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@11.12.0"
}
