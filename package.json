{
  "name": "vibest",
  "private": true,
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "watch": "vp run -r --parallel dev",
    "stub": "vp run -r --parallel stub",
    "build": "vp run -r build",
    "build:extension": "vp run --filter ./apps/chrome-side-panel --filter ./chrome-extension build",
    "build:packages": "vp run --filter \"./packages/*\" build",
    "bump": "pnpm taze",
    "test": "vp test",
    "pack": "vp run --filter ./apps/vscode pack",
    "clean": "vp run -r clean && git clean -xdf node_modules dist .turbo",
    "sherif": "pnpm dlx sherif --fix",
    "lint": "vp lint --fix",
    "lint:check": "vp lint --check",
    "format:check": "vp fmt --check",
    "format": "vp fmt",
    "check": "vp check",
    "typecheck": "vp run -r typecheck",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepublish": "vp run --filter \"./packages/*\" build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@types/node": "^24.10.13",
    "publint": "^0.3.12",
    "taze": "^19.5.0",
    "typescript": "^5.9.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.11.0"
}
