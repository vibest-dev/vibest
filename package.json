{
  "name": "vibest",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "watch": "turbo watch dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --fix",
    "lint:check": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run lint:check && pnpm run format:check && pnpm run typecheck",
    "clean": "turbo run clean && git clean -xdf node_modules dist .turbo",
    "bump": "pnpm taze",
    "sherif": "pnpm dlx sherif --fix",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks",
    "doctor": "turbo run doctor"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "catalog:",
    "lint-staged": "^17.1.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.74.0",
    "publint": "^0.3.21",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.14.1",
    "tsdown": "catalog:",
    "tsx": "latest",
    "turbo": "^2.10.5",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged"
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@11.12.0"
}
