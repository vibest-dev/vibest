{
  "name": "ai-sdk-agents",
  "version": "0.0.1",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./claude-code": {
      "types": "./src/claude-code/index.ts",
      "import": "./dist/claude-code/index.js",
      "require": "./dist/claude-code/index.cjs"
    }
  },
  "scripts": {
    "stub": "pnpm run build",
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "clean": "git clean -xdf node_modules .turbo dist"
  },
  "devDependencies": {
    "@ai-sdk/provider-utils": "^5.0.7",
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "@vibest/typescript": "workspace:*",
    "ai": "^7.0.22",
    "vitest": "catalog:",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "ai": "^7.0.22",
    "zod": "^4.4.3"
  }
}
