{
  "name": "@vibest/cli",
  "version": "0.0.2-dev",
  "description": "vibest: vibestd daemon and the vibest CLI. An entry session directing sessions in herdr panes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibest-dev/vibest.git",
    "directory": "packages/cli"
  },
  "bin": {
    "vibest": "./bin/vibest"
  },
  "files": [
    "bin",
    "LICENSE"
  ],
  "type": "module",
  "imports": {
    "#platform": {
      "bun": "@vibest/platform-bun/bun"
    }
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "bun script/build.ts",
    "pack:npm": "bun script/pack.ts",
    "typecheck": "tsrs --noEmit --fast",
    "test": "cd ../.. && bun ./node_modules/vitest/vitest.mjs run packages/cli/"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@vibest/client": "workspace:*",
    "@vibest/core": "workspace:*",
    "@vibest/herdr-sdk": "workspace:*",
    "@vibest/platform-bun": "workspace:*",
    "@vibest/plugin": "workspace:*",
    "@vibest/plugin-builtins": "workspace:*",
    "@vibest/plugin-harnesses": "workspace:*",
    "@vibest/protocol": "workspace:*",
    "@vibest/runtime-herdr": "workspace:*",
    "@vibest/runtime-herdr-core": "workspace:*",
    "@vibest/schema": "workspace:*",
    "@vibest/server": "workspace:*",
    "@vibest/testkit": "workspace:*",
    "effect": "catalog:"
  }
}
