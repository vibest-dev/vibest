{
  "name": "@vibest/client",
  "version": "0.0.2-dev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsrs --noEmit --fast && tsrs --noEmit --fast -p tsconfig.core.json && tsrs --noEmit --fast -p test/tsconfig.json",
    "test": "cd ../.. && bun ./node_modules/vitest/vitest.mjs run packages/client"
  },
  "dependencies": {
    "@vibest/protocol": "workspace:*",
    "@vibest/schema": "workspace:*",
    "effect": "catalog:"
  }
}
