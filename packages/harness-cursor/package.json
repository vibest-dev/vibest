{
  "name": "@vibest/harness-cursor",
  "version": "0.0.2-dev",
  "private": true,
  "description": "vibest's Cursor CLI plugin: a session's execution-end result and the tool guard, loaded with `cursor-agent --plugin-dir`.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibest-dev/vibest.git",
    "directory": "packages/harness-cursor"
  },
  "files": [
    "src",
    ".cursor-plugin/plugin.json",
    "hooks/hooks.json",
    "hooks/vibest.sh",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./plugin": "./src/plugin.ts"
  },
  "scripts": {
    "build": "bun script/build.ts",
    "prepack": "bun run build",
    "typecheck": "tsrs --noEmit --fast",
    "test": "cd ../.. && bun ./node_modules/vitest/vitest.mjs run packages/harness-cursor"
  },
  "devDependencies": {
    "@vibest/schema": "workspace:*"
  }
}
