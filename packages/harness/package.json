{
  "name": "@vibest/harness",
  "version": "0.0.1",
  "private": true,
  "description": "Harness agent adapters for Vibe Coding Devtools",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./claude-code": "./src/claude-code/index.ts",
    "./codex": "./src/codex/index.ts",
    "./codex/protocol": "./src/codex/protocol/index.ts",
    "./codex/protocol/v2": "./src/codex/protocol/v2/index.ts",
    "./pi": "./src/pi/index.ts",
    "./pi/protocol": "./src/pi/protocol.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf node_modules dist .turbo"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@earendil-works/pi-coding-agent": "0.80.7",
    "@vibest/contract": "workspace:*",
    "ai": "catalog:",
    "effect": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@orpc/contract": "catalog:orpc",
    "@vibest/typescript": "workspace:*"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
