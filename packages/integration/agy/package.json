{
  "name": "@vibest/agy",
  "version": "0.0.2-dev",
  "private": true,
  "description": "vibest's Antigravity CLI plugin: a workspace plugin loaded with `agy --add-dir` whose hooks report a session's conversation, work and execution end.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibest-dev/vibest.git",
    "directory": "packages/integration/agy"
  },
  "files": [
    "src",
    ".agents/plugins/vibest/plugin.json",
    ".agents/plugins/vibest/hooks.json",
    ".agents/plugins/vibest/hook.sh",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./plugin": "./src/plugin.ts"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "typecheck": "tsrs --noEmit --fast",
    "test": "cd ../../.. && bun ./node_modules/vitest/vitest.mjs run packages/integration/agy"
  },
  "devDependencies": {
    "@vibest/schema": "workspace:*"
  }
}
