{
  "name": "@vibest/platform-bun",
  "version": "0.0.2-dev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#platform": {
      "bun": "./src/bun.ts"
    }
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsrs --noEmit --fast && tsrs --noEmit --fast -p test/tsconfig.json",
    "test": "cd ../.. && bun ./node_modules/vitest/vitest.mjs run packages/platform-bun"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@vibest/client": "workspace:*",
    "@vibest/core": "workspace:*",
    "@vibest/herdr-sdk": "workspace:*",
    "@vibest/mcp": "workspace:*",
    "@vibest/plugin": "workspace:*",
    "@vibest/plugin-builtins": "workspace:*",
    "@vibest/schema": "workspace:*",
    "@vibest/server": "workspace:*",
    "@vibest/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@vibest/protocol": "workspace:*",
    "@vibest/runtime-herdr": "workspace:*",
    "@vibest/runtime-herdr-core": "workspace:*"
  }
}
