{
  "name": "@vibest/plugin",
  "version": "0.0.1-dev",
  "description": "Authoring API for vibest plugins. vibestd provides this module (and effect) to plugins at runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibest-dev/vibest.git",
    "directory": "packages/plugin"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/promise/index.ts",
    "./effect": "./src/effect/index.ts",
    "./promise/adapter": "./src/promise/adapter.ts",
    "./testing": "./src/testing.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
