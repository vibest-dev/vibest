{
  "name": "@vibest/server",
  "version": "0.0.1-dev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#platform": {
      "bun": "@vibest/platform-bun/bun"
    }
  },
  "exports": {
    "./test/*": "./test/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsrs --noEmit --fast && tsrs --noEmit --fast -p test/tsconfig.json",
    "test": "cd ../.. && bun ./node_modules/vitest/vitest.mjs run packages/server"
  },
  "dependencies": {
    "@vibest/client": "workspace:*",
    "@vibest/core": "workspace:*",
    "@vibest/plugin": "workspace:*",
    "@vibest/protocol": "workspace:*",
    "@vibest/schema": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@vibest/platform-bun": "workspace:*",
    "@vibest/runtime-herdr": "workspace:*",
    "@vibest/runtime-herdr-core": "workspace:*",
    "effect-herdr-sdk": "workspace:*"
  }
}
