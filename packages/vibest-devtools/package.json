{
  "name": "vibest-devtools",
  "version": "0.0.4",
  "description": "A vite plugin that allow you direct chat with your claude code",
  "keywords": [
    "rspack",
    "unplugin",
    "vite",
    "webpack"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "exports": {
    "./vite": "./dist/vite.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "stub": "vp pack",
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf node_modules dist .turbo"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "@orpc/server": "^2.0.0-beta.16",
    "@types/ws": "^8.18.1",
    "ai": "^5.0.63",
    "sirv": "^3.0.2",
    "tiny-invariant": "^1.3.3",
    "ws": "^8.18.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.13",
    "@vibest/agents": "workspace:*",
    "@vibest/server-rpc": "workspace:*",
    "publint": "^0.3.12",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": ">=3"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
