    "@orpc/contract": "catalog:orpc",
    "@orpc/server": "catalog:orpc",
    "ai": "catalog:",
    "effect": "catalog:",
    "sirv": "^3.0.2",
    "uuid": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/ws": "catalog:",
    "@vibest/server": "workspace:*",
    "@vibest/typescript": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
