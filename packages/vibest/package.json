{
  "name": "@vibest/cli",
  "version": "0.0.1",
  "bin": {
    "vibest": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx src/node/cli.ts",
    "build": "tsdown",
    "start": "node dist/cli.mjs",
