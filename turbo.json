{
  "$schema": "https://turborepo.com/schema.v2.json",
  "tasks": {
    "stub": {
      "outputs": ["dist/**"],
      "dependsOn": ["^stub"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "dependsOn": ["^stub"]
    },
    "build": {
      "outputs": ["dist/**"],
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
