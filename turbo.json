{
  "$schema": "https://turborepo.com/schema.v2.json",
  "globalDependencies": [
    "tools/tsconfig/base.json",
    "tools/tsconfig/neutral.json",
    "tools/tsconfig/web-globals.d.ts",
    "vitest.config.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bin/vibest", "harnesses/**"]
    },
    "@vibest/cli#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/harness-*/src/**",
        "$TURBO_ROOT$/packages/harness-*/{script,hooks}/**",
        "$TURBO_ROOT$/packages/harness-*/{package.json,README.md,LICENSE}",
        "$TURBO_ROOT$/packages/skills/**"
      ],
      "outputs": ["dist/**", "bin/vibest", "harnesses/**"]
    },
    "@vibest/harness-claude#build": { "cache": false },
    "@vibest/harness-cursor#build": { "cache": false },
    "@vibest/harness-agy#build": { "cache": false },
    "@vibest/harness-pi#build": { "cache": false },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@vibest/cli#test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "//#e2e": {
      "dependsOn": ["@vibest/cli#build"],
      "inputs": ["e2e/src/**"],
      "outputs": [],
      "cache": true
    }
  }
}
