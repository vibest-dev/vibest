{
  "$schema": "https://turborepo.com/schema.v2.json",
  "globalDependencies": ["tools/tsconfig/base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bin/vibest", "harnesses/**"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "cache": false
    }
  }
}
